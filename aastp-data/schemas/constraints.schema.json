{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$id": "https://aastp.org/schemas/constraints.schema.json",

    "title": "AASTP Constraints Definitions",

    "type": "object",

    "required": [
        "schemaVersion",
        "metadata",
        "constraints"
    ],

    "properties": {

        "schemaVersion": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
        },

        "metadata": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
        },

        "constraints": {
            "type": "array",

            "minItems": 1,

            "items": {
                "type": "object",

                "required": [
                    "id",
                    "code",
                    "category",
                    "name",
                    "description",
                    "source"
                ],

                "properties": {

                    "id": {
                        "$ref": "./defs/common.schema.json#/$defs/constraintId"
                    },

                    "code": {
                        "type": "string",
                        "pattern": "^[A-Z0-9_]+$"
                    },

                    "category": {
                        "type": "string",
                        "enum":[
                            "mandatory",
                            "advisory"
                        ]
                    },

                    "name": {
                        "type": "string",
                        "minLength": 1
                    },

                    "description": {
                        "type": "string",
                        "minLength": 1
                    },

                    "source": {
                        "type": "object",
                        "required": [
                            "document",
                            "para"
                        ],
                        "properties": {
                            "document": {"type": "string"},
                            "para": {"type": "string"}
                        },
                        "additionalProperties": false
                    }
                },

                "additionalProperties": false
            }
        }
    }
}
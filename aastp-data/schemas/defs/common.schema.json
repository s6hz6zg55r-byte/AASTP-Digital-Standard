{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://aastp.org/schemas/defs/common.schema.json",


  "title": "AASTP Common Schema Definitions",

  "$defs": {

    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "metadata": {
      "type": "object",

      "required": [
        "dataset",
        "title",
        "description",
        "version",
        "source"
      ],

      "properties": {

        "dataset": {
          "type": "string"
        },

        "title": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "version": {
          "$ref": "#/$defs/version"
        },

        "source": {
          "$ref": "#/$defs/source"
        }
      },

      "additionalProperties": false
    },

    "source": {
      "type": "object",

      "required": [
        "standard",
        "edition",
        "chapter",
        "para",
        "lastUpdated"
      ],

      "properties": {

        "standard": {
          "type": "string"
        },

        "edition": {
          "type": "string"
        },

        "chapter": {
          "type": "string"
        },

        "para": {
          "type": "string"
        },

        "lastUpdated": {
          "type": "string",
          "format": "date"
        }
      },

      "additionalProperties": false
    },

    "traceability": {
      "type": "object",

      "required": [
        "Part",
        "Section",
        "Table",
        "Row"
      ],

      "properties": {

        "Part": {
          "type": "string"
        },

        "Section": {
          "type": "string"
        },

        "Table": {
          "type": "string"
        },

        "Row": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "formulaId": {
      "type": "string",
      "pattern": "^FORM[0-9]{3}$"
    },

    "distanceRuleId": {
      "type": "string",
      "pattern": "^(BD[0-9]{2}|TD[0-9]{2}|DFD[0-9]{2}|FD[0-9]{2}|P1D[1-4]|P2D[1-4])$"
    },

    "transformationsId": {
      "type": "string",
      "pattern": "^TR[0-9]{3}$"
    },

    "effectId": {
      "type": "string",
      "pattern": "^EFF[0-9]{3}$"
    },

    "applicability": {
        "type": "object",
        "required": [
            "minNEQ",
            "maxNEQ"
        ],
        "properties": {
            "minNEQ": {
            "type": "number",
            "minimum": 0
        },
        "maxNEQ": {
            "type": "number",
            "exclusiveMinimum": 0
            }
        },
        "additionalProperties": false
    },

    "namedEntity": {
        "type": "object",
        "required": [
            "id",
            "name",
            "description"
        ],
        "properties": {
            "id": {"type": "string"},
            "name": {"type": "string"},
            "description": {"type": "string"}
        },
        "additionalProperties": false
    },

    "recordSource": {
        "type": "object",
        "required": [
            "document",
            "note"
        ],
        "properties": {
            "document": {
            "type": "string"
            },
            "note": {"type": "string"}
        },
        "additionalProperties": false
    },

    "structureId": {
        "type": "string",
        "pattern": "^STR[0-9]{3}$"
    },

    "esTypeId": {
        "type": "string",
        "pattern": "^ES[0-9]{3}[A-Z]?$"
    },

    "pesTypeId": {
        "type": "string",
        "pattern": "^PES[0-9]{3}[A-Z]?$"
    },

    "hazardCategoriesId": {
        "type": "string",
        "pattern": "^HD[0-9]{3}$"
    },

    "protectionRatingId": {
        "type": "string",
        "pattern": "^PR[0-9]{3}$"
    },

    "protectionLevelId": {
        "type": "string",
        "pattern": "^PL[0-9]{3}$"
    },

    "constraintId": {
        "type": "string",
        "pattern": "^CV[0-9]{3}$"
    },

    "orientationTypeId": {
        "type": "string",
        "pattern": "^OR[0-9]{3}$"
    },

    "interactionId": {
        "type": "string",
        "pattern": "^INT[0-9]{3}$"
    },

    "branchCondition": {
        "type": "object",
        "required": ["neq"],
        "properties": {
            "neq": {
                "type": "object",
                "properties": {
                    "gte": { "type": "number" },
                    "gt": { "type": "number" },
                    "lte": { "type": "number" },
                    "lt": { "type": "number" }
                },
                "additionalProperties": false
            }
        },
        "additionalProperties": false
    },

    "supportedProperties": {
        "type": "object",
        "required": [
            "ecmProtectionRating",
            "headwall",
            "barricaded",
            "roofType",
            "aperture"
        ],
        "properties": {
            "ecmProtectionRating": {"type":"boolean"},
            "headwall": {"type":"boolean"},
            "barricaded": {"type":"boolean"},
            "roofType": {"type": ["boolean", "null"]},
            "aperture": {"type": ["boolean", "null"]}
        },
        "additionalProperties": false
    },

    "supportedExposure": {
        "type": "object",
        "required": [
            "category",
            "level"
        ],
        "properties": {
            "category": {"type":"boolean"},
            "level": {"type":"boolean"}
        },
        "additionalProperties": false
    },

    "genericId": {
      "type": "string",
      "minLength": 1
    },

    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "appliesTo": {
          "$ref": "#/$defs/appliesTo"
        },
        "when": {
          "$ref": "#/$defs/conditionGroup"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      },

      "required": [
        "id",
        "status",
        "appliesTo",
        "when",
        "outcome",
        "governance"
      ]
    },

    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetId": {
          "type": "string"
        },

        "resourceType": {
          "type": "string"
        },

        "context": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalarValue"
          }
        }
      },

      "required": [
        "datasetId",
        "resourceType"
      ]
    },

    "scalarValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },

    "predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/equalsPredicate"
        },
        {
          "$ref": "#/$defs/typePredicate"
        }
      ]
    },

    "equalsPredicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "property": {
          "type": "string"
        },
        "operator": {
          "const": "equals"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      },

      "required": [
        "property",
        "operator",
        "value"
      ]
    },

    "typePredicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "property": {
          "type": "string"
        },
        "operator": {
          "const": "type_is"
        },
        "value": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "property",
        "operator",
        "value"
      ]
    },

    "conditionGroup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionNode"
              }
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionNode"
              }
            }
          },
          "required": [
            "any"
          ]
        }
      ]
    },

    "conditionNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "$ref": "#/$defs/conditionGroup"
        }
      ]
    },

    "outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/canonicalOutcome"
        },
        {
          "$ref": "#/$defs/undefinedOutcome"
        }
      ]
    },

    "canonicalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "redundant_parameter",
            "non_applicable_parameter",
            "canonicalisation"
          ]
        },
        "canonicalAssignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "canonicalTargetId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "canonicalAssignments",
        "canonicalTargetId"
      ]
    },

    "undefinedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "undefined_configuration"
        }
      },
      "required": [
        "type"
      ]
    },

    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "property": {
          "type": "string"
        },

        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      },

      "required": [
        "property",
        "value"
      ]
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "rationale",
        "source",
        "effectiveFrom"
      ]
    }

  }
}
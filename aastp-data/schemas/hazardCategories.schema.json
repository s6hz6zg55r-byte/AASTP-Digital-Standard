{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$id": "https://aastp.org/schemas/hazardCategories.schema.json",

    "title": "AASTP Hazard Categories",

    "type": "object",

    "required": [
        "schemaVersion",
        "metadata",
        "hazard_divisions"
    ],
    "properties": {
        "schemaVersion": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
        },
        "metadata": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
        },
        "hazard_divisions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "code",
                    "name",
                    "description",
                    "parentDivision",
                    "type",
                    "active",
                    "source",
                    "effects",
                    "supportedQuantityBasis"
                ],
                "properties": {
                    "id": {
                        "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/hazardCategoriesId"
                    },
                    "code": {
                        "type": "string",
                        "minLength": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1
                    },
                    "parentDivision": {
                        "anyOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1
                            }
                        ]
                    },
                    "type": {
                        "type": "string",
                        "minLength": 1
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "source": {
                        "type": "object",
                        "required": [
                            "document",
                            "para"
                        ],
                        "properties": {
                            "document": {
                                "type": "string",
                                "minLength": 1
                            },
                            "para": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    },
                    "effects": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "./defs/common.schema.json#/$defs/effectId"
                        }
                    },
                    "supportedQuantityBasis": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    }
}
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$id": "https://aastp.org/schemas/resourcePropertySemantics.schema.json",

    "title": "Resource Property Semantics",

    "type": "object",

    "required": [
        "schemaVersion",
        "metadata",
        "property_semantics"
    ],

    "properties": {

        "schemaVersion": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
        },

        "metadata": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
        },

        "property_semantics": {
            "type": "array",

            "minItems": 1,

            "items": {
                "type": "object",

                "required": [
                    "property",
                    "role"
                ],

                "properties": {

                    "property": {
                        "type": "string"
                    },

                    "role": {
                        "type": "string"
                    },

                    "derivedFrom": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
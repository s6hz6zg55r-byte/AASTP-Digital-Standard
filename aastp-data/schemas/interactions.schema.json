{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    
    "$id": "https://aastp.org/schemas/interactions.schema.json",

    "title": "Interactions",

    "type": "object",

     "required": [
        "schemaVersion",
        "metadata",
        "interaction_rules"
    ],

    "properties": {
        "schemaVersion": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
        },

        "metadata": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
        },

        "interaction_rules": {
            "type": "array",

            "items": {

                "type": "object",

                "required": [
                    "id",
                    "source",
                    "conditions",
                    "effects"
                ],

                "properties": {
                    "id": {
                        "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/interactionId"
                    },
                    "source": {
                        "type": "object",
                        "required": [
                            "document",
                            "reference"
                        ],
                        "properties": {
                            "document": {
                                "type": "string",
                                "minLength": 1
                            },
                            "reference": {
                                "type": "object",
                                "required": [
                                    "table",
                                    "row",
                                    "column"
                                ],
                                "properties": {
                                    "table": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "row": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "column": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    },
                    "conditions": {
                        "type": "object",
                        "required": [
                            "pesType",
                            "esType",
                            "orientation"
                        ],
                        "properties": {
                            "pesType": {
                                "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/pesTypeId"
                            },
                            "esType": {
                                "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/esTypeId"
                            },
                            "orientation": {
                                "type": "object",
                                "required": [
                                    "pes",
                                    "es"
                                ],
                                "properties": {
                                    "pes": {
                                        "enum": [
                                            "front",
                                            "side",
                                            "rear",
                                            "any"
                                        ]
                                    },
                                    "es": {
                                        "enum": [
                                            "front",
                                            "side",
                                            "rear",
                                            "any"
                                        ]
                                    }
                                }
                            }
                        }   
                    },
                    "effects": {
                        "type": "object",
                        "required": [
                            "EFF001",
                            "EFF002",
                            "EFF003",
                            "EFF004"
                        ],
                        "properties": {
                            "EFF001": {
                                "$ref": "#/$defs/effectArray"
                            },
                            "EFF002": {
                                "$ref": "#/$defs/effectArray"
                            },
                            "EFF003": {
                                "$ref": "#/$defs/effectArray"
                            },
                            "EFF004": {
                                "$ref": "#/$defs/effectArray"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,

    "$defs": {
        "effectArray": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/effectAssessment"
            }
        },

        "effectAssessment": {
            "type": "object",
            "oneOf":[
                { "$ref": "#/$defs/statusAssessment" },
                { "$ref": "#/$defs/distanceAssessment" }
            ]
        },

        "statusAssessment": {
            "type": "object",
            "required": [
                "hazard",
                "status"
            ],
            "properties": {
                "hazard": {
                    "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/hazardCategoriesId"
                },
                "status": {
                    "enum": [
                        "N_A",
                        "NO_QD"
                    ]
                }
            },
            "additionalProperties": false
        },

        "distanceAssessment": {
            "type": "object",
            "required": [
                "hazard",
                "distanceRule",
                "inputBasis",
                "protectionLevel",
                "constraints"
            ],
            "properties": {
                "hazard": {
                    "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/hazardCategoriesId"
                },
                "distanceRule": {
                    "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/distanceRuleId"
                },
                "inputBasis": {
                    "enum": [
                        "NEQ",
                        "MCE"
                    ]
                },
                "protectionLevel": {
                    "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/protectionLevelId"
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/constraintId"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}


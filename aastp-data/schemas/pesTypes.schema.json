{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://aastp.org/schemas/pesTypes.schema.json",

    "title": "PES Types",
    "description": "Potential Explosion Site type definitions.",

    "type": "object",

    "required": [
        "schemaVersion",
        "metadata",
        "pes_types"
    ],

    "properties": {
        "schemaVersion": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
        },

        "metadata": {
            "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
        },

        "pes_types": {
            "type": "array",

            "items": {
                "type": "object",

                "required": [
                    "id",
                    "code",
                    "name",
                    "structure",
                    "construction",
                    "notes",
                    "source"
                ],
                
                "properties": {
                    "id": {
                        "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/pesTypeId"
                    },
                    "code": {
                        "type": "string",
                        "minLength": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "structure": {
                        "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/structureId"
                    },
                    "construction": {
                        "anyOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "aperture",
                                    "barricaded",
                                    "roofType"
                                ],
                                "properties": {
                                    "aperture": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ]
                                    },
                                    "barricaded": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ]
                                    },
                                    "roofType": {
                                        "anyOf": [
                                            {
                                                "enum": [
                                                    "Protective",
                                                    "Light"
                                                ]
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "notes": {
                        "type": "string"
                    },
                    "source": {
                        "type": "object",
                        "properties": {
                            "document": {"type": "string"},
                            "para": {"type": "string"}
                        },

                        "required": [
                            "document",
                            "para"
                        ],
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
                }           
            }
        },
    "additionalProperties": false
   
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://aastp.org/schemas/formulas.schema.json",

  "title": "AASTP Formula Definitions",

  "type": "object",

  "required": [
    "schemaVersion",
    "metadata",
    "formulas"
  ],

  "properties": {

    "schemaVersion": {
      "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/schemaVersion"
    },

    "metadata": {
      "$ref": "https://aastp.org/schemas/defs/common.schema.json#/$defs/metadata"
    },

    "formulas": {
      "type": "array",

      "minItems": 1,

      "items": {
        "type": "object",

        "required": [
          "id",
          "code",
          "name",
          "description",
          "expressionOwner",
          "solvable",
          "engineeringUnits",
          "parameters"
        ],

        "properties": {

          "id": {
            "$ref": "./defs/common.schema.json#/$defs/formulaId"
          },

          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },

          "name": {
            "type": "string",
            "minLength": 1
          },

          "description": {
            "type": "string",
            "minLength": 1
          },

          "expressionOwner": {
            "type": "string",
            "enum": [
              "formulas", 
              "distanceRules"
            ]
          },

          "solvable": {
            "type": "object",
            "required": [
              "forward",
              "reverse"
            ],
            "properties": {
              "forward": {
                "type": "boolean"
              },
              "reverse": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },

          "engineeringUnits": {
            "type": "object",
            "properties": {
              "forward": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },

              "reverse": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },

            "additionalProperties": false
          },

          "parameters": {
            "type": "object",

            "properties": {

              "forward": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },

              "reverse": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },

            "additionalProperties": false
          },

          "forwardExpression": {
            "type": "string",
            "minLength": 1
          },

          "reverseExpression": {
            "type": "string",
            "minLength": 1
          }
        },

        "allOf": [
          {
            "if": {
              "properties": {
                "solvable": {
                  "required": ["forward"],
                  "properties": {
                    "forward": {
                      "const": true
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "engineeringUnits": {
                  "required": [
                    "forward"
                  ]
                },
                "parameters": {
                  "required": [
                    "forward"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "solvable": {
                  "properties": {
                    "reverse": {
                      "const": true
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "engineeringUnits": {
                  "required": [
                    "reverse"
                  ]
                },
                "parameters": {
                  "required": [
                    "reverse"
                  ]
                }
              }
            }
          }
        ],

        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}